{
  "info": {
    "name": "Blockchain",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "Jack",
      "item": [
        {
          "name": "Health",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{jack}}/health",
              "host": ["{{jack}}"],
              "path": ["health"]
            }
          }
        },
        {
          "name": "Chain",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const chain = pm.response.json();",
                  "pm.environment.set(\"jack_latest_hash\", chain[chain.length - 1].hash);"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{jack}}/chain",
              "host": ["{{jack}}"],
              "path": ["chain"]
            }
          }
        },
        {
          "name": "Blocks After Tony's Latest",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{jack}}/blocks-after/{{tony_latest_hash}}",
              "host": ["{{jack}}"],
              "path": ["blocks-after", "{{tony_latest_hash}}"]
            },
            "description": "Run Tony > Chain first, it saves Tony's latest hash into {{tony_latest_hash}}."
          }
        },
        {
          "name": "Add Block",
          "request": {
            "method": "POST",
            "header": [],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"block\": \"Jack pays Tony 5\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{jack}}/add-block",
              "host": ["{{jack}}"],
              "path": ["add-block"]
            }
          }
        },
        {
          "name": "Validate",
          "request": {
            "method": "POST",
            "header": [],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"block\": {\n    \"index\": 1,\n    \"timestamp\": 0,\n    \"data\": \"Tony pays Jack 1000\",\n    \"prev_hash\": \"abc\",\n    \"hash\": \"fake\"\n  },\n  \"sender\": \"tony\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{jack}}/validate",
              "host": ["{{jack}}"],
              "path": ["validate"]
            }
          }
        }
      ]
    },
